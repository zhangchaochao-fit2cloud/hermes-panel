{
  "name": "@hermes-panel/bff",
  "version": "0.1.0-beta.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "bundle:desktop": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=../../packages/panel-desktop/src-tauri/resources/bff/dist/server.js --external:better-sqlite3 --external:keytar --banner:js=\"import { createRequire } from 'node:module';const require = createRequire(import.meta.url);\" --minify",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hermes-panel/shared": "workspace:*",
    "@koa/cors": "5.0.0",
    "@koa/router": "13.1.0",
    "better-sqlite3": "11.3.0",
    "keytar": "7.9.0",
    "koa": "2.15.3",
    "koa-bodyparser": "4.4.1",
    "pino": "9.4.0",
    "pino-pretty": "11.2.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/koa": "2.15.0",
    "@types/koa-bodyparser": "4.3.12",
    "@types/koa__cors": "5.0.0",
    "@types/koa__router": "12.0.4",
    "@types/node": "20.14.10",
    "@types/supertest": "6.0.2",
    "esbuild": "0.24.0",
    "supertest": "7.0.0",
    "tsx": "4.22.3",
    "typescript": "5.4.5",
    "vitest": "2.1.1"
  }
}
