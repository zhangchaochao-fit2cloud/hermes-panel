{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Hermes Panel",
  "mainBinaryName": "Hermes Panel",
  "version": "0.1.0",
  "identifier": "org.hermespanel.desktop",
  "build": {
    "beforeDevCommand": "bash ../../scripts/tauri-dev-prep.sh",
    "beforeBuildCommand": "pnpm --filter @hermes-panel/bff build && pnpm --filter @hermes-panel/web build && bash ../../scripts/prepare-desktop-web-dist.sh && bash ../../scripts/prepare-desktop-resources.sh",
    "devUrl": "http://127.0.0.1:5666",
    "frontendDist": "../../panel-web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hermes Panel",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/bff"
    ],
    "category": "Productivity",
    "shortDescription": "Beautiful Web UI for Hermes Agent",
    "longDescription": "Hermes Panel is a beautiful, easy-to-use control panel for the Hermes Agent.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {}
}
